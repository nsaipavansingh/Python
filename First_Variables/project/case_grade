age = int(input("enter your age: "))
nationality = input("enter your nationality: ")
if age >= 18 and nationality == "Indian":
    print("You are eligible to vote.")
else:
    print("You are not eligible to vote.")

#########################################

student_name = input("Enter student name:")

print(f"Student Name: {student_name}")

##########################################
student_grade = int(input("Enter student grade (0-100): "))

if student_grade >= 90:
    grade_category = "A"
elif student_grade >= 80:
    grade_category = "B"
elif student_grade >= 70:
    grade_category = "C"
elif student_grade >= 60:
    grade_category = "D"
else:
    grade_category = "F"

print(f"Student Grade: {student_grade}")   
print(f"Grade Category: {grade_category}")

##########################################

student_tuition_fee = 0
match grade_category:
    case "A":
        student_tuition_fee = 0
    case "B":
        student_tuition_fee = 1000
    case "C":
        student_tuition_fee = 2000
    case "D":
        student_tuition_fee = 3000
    case "F":           
        student_tuition_fee = 4000       

print(f"Tuition Fee for {student_name} with grade {grade_category} is: ${student_tuition_fee}")

###########################################

student_discount = 20
if student_tuition_fee > 0:
    discount_amount = (student_discount / 100) * student_tuition_fee
    final_tuition_fee = student_tuition_fee - discount_amount
else:
    final_tuition_fee = student_tuition_fee


############################################
# Final Output
print("----- Final Output -----")
print(f"Student Name: {student_name}")
print(f"Student Grade: {student_grade}")   
print(f"Grade Category: {grade_category}")
print(f"Original Tuition Fee: ${student_tuition_fee}")
print(f"Discount Applied: {student_discount}%")
print(f"Final Tuition Fee after Discount: ${final_tuition_fee}")    




